{
  "build": [
    "python -m venv .venv",
    ".venv\\Scripts\\python.exe -m pip install -q --upgrade pip",
    ".venv\\Scripts\\python.exe -m pip install -q -r requirements.txt"
  ],
  "start": [".venv/Scripts/python.exe", "-m", "waitress", "--host=127.0.0.1", "--port=${PORT}", "--threads=${WORKERS}", "main:app"],
  "notes": "waitress, WORKERS threads in one process (gunicorn does not run on Windows)"
}
